# O2 Login-Zugangsdaten (mein-o2.de / o2online.de)
O2_USERNAME=
O2_PASSWORD=

# Optional: abweichende URLs, falls sich das O2-Portal aendert
O2_LOGIN_URL=https://login.o2online.de/signin/?goto=https%3A%2F%2Fwww.o2online.de%2Fmein-o2%2F
O2_INVOICE_URL=https://www.o2online.de/mein-o2/rechnung/

# Wohin die heruntergeladene PDF-Rechnung zwischengespeichert wird
DOWNLOAD_DIR=./downloads

# Gmail-Versand (SMTP mit App-Passwort, siehe README.md)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Empfaenger der weitergeleiteten Rechnung (Komma-getrennt fuer mehrere Adressen)
MAIL_TO=
